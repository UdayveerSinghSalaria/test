# =============================================================================
# AI Work Assistant — backend environment
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="AI Work Assistant"          # Central, configurable product name.
APP_ENV=development                   # development | production
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5174

# --- Database ----------------------------------------------------------------
# Supabase/Postgres (target):
#   DATABASE_URL=postgresql+psycopg://postgres.<PROJECT>:<PASSWORD>@aws-0.<REGION>.pooler.supabase.com:6543/postgres
# SQLite fallback for local dev (default when unset):
DATABASE_URL=sqlite:///./assistant.db

# --- Security (REQUIRED — app refuses to start without these) ----------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=
# Comma-separated exact origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials) -----
# Local redirect URI: http://localhost:8000/api/integrations/google/callback
# Production uses the Netlify origin: https://<site>.netlify.app/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# --- LLM (configurable provider; leave empty to disable agent features) ------
# OpenAI-compatible examples:
#   LLM_PROVIDER=openai-compatible  LLM_BASE_URL=https://openrouter.ai/api/v1
#   NVIDIA NIM: LLM_PROVIDER=openai-compatible LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_PROVIDER=anthropic          LLM_BASE_URL=https://api.anthropic.com/v1
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- Activepieces mailbox ----------------------------------------------------
ACTIVEPIECES_BASE_URL=https://cloud.activepieces.com/api/v1
ACTIVEPIECES_API_KEY=
ACTIVEPIECES_PROJECT_ID=
ACTIVEPIECES_GMAIL_CONNECTION_ID=
ACTIVEPIECES_SEARCH_FLOW_ID=
ACTIVEPIECES_GET_FLOW_ID=
ACTIVEPIECES_SEND_FLOW_ID=
# Exact SaarthiFlow login email allowed to use this mailbox.
ACTIVEPIECES_ALLOWED_USER_EMAIL=
