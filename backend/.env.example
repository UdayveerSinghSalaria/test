# Database
# Use SQLite for local dev, PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./saarthiflow.db
# For Supabase/PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# NVIDIA Nemotron 3 Ultra
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Email (SMTP for sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM="SaarthiFlow <your_email@gmail.com>"

# IMAP for reading (per-user, stored encrypted in DB)
# These are defaults for Gmail; users configure their own in Settings
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Activepieces (fallback for email reading)
ACTIVEPIECES_API_KEY=your_activepieces_key
ACTIVEPIECES_BASE_URL=https://cloud.activepieces.com/api/v1
ACTIVEPIECES_SEARCH_FLOW_ID=your_search_flow_id
ACTIVEPIECES_GET_FLOW_ID=your_get_flow_id

# Security
SECRET_KEY=generate_with_openssl_rand_hex_32
FERNET_KEY=generate_with_cryptography_fernet_generate_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Environment
ENVIRONMENT=development
PORT=8000